# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
#   cp .env.example .env

# 세션 쿠키 서명 키. 반드시 아래 명령으로 무작위 값을 생성해서 넣는다.
#   python -c "import secrets; print(secrets.token_hex(32))"
# 이 값이 바뀌면 접속 중인 관리자·참가자가 전부 로그아웃된다.
SESSION_SECRET=

# Cloudflare Tunnel 등으로 공인 인터넷에 노출할 때만 true.
# true인 채로 http://localhost:8000에 직접 붙으면 브라우저가 Secure 쿠키를
# 저장하지 않아 로그인이 깨진다. 로컬 전용 테스트 중에는 false로 둔다.
SESSION_HTTPS_ONLY=false

# 관리자 로그인 폼이 열리는 비밀 경로 (admin-access-hardening.md).
# 이 주소로만 로그인 화면이 뜨고, /admin/login은 존재하지 않는다.
# 미인증 상태로 /admin에 들어가면 로그인 화면이 아니라 404가 나온다 — 의도된 동작이다.
# 아래 명령으로 만들어 넣는다:
#   python -c "import secrets,string;a=string.ascii_lowercase+string.digits;print('/_ops/'+''.join(secrets.choice(a) for _ in range(14)))"
# 운영 배포(docker-compose.prod.yml)에서는 필수다. 없으면 web 컨테이너가 뜨지 않는다.
ADMIN_LOGIN_PATH=/admin/login

# 관리자 로그인 실패 잠금 (선택). 생략하면 5회 / 15분.
# 잠긴 계정은 `docker compose restart web`으로 즉시 풀 수 있다.
#ADMIN_LOGIN_MAX_ATTEMPTS=5
#ADMIN_LOGIN_LOCKOUT_MINUTES=15

# 참가자 로그인 실패 잠금 (선택). 생략하면 10회 / 5분.
# 관리자보다 느슨하다 — 막으려는 것이 비밀번호 추측이 아니라 bcrypt 연산으로 서버를
# 마비시키는 것이기 때문이다. 너무 빡빡하면 비밀번호를 잘못 붙여넣은 참가자가
# 대회 중에 제출을 못 하게 된다. 관리자 카운터와는 분리되어 서로 잠기지 않는다.
#TEAM_LOGIN_MAX_ATTEMPTS=10
#TEAM_LOGIN_LOCKOUT_MINUTES=5

# 팀당 하루 제출 한도 (선택). 생략하면 3회.
# 대회 중 대기열이 밀리면 이 값을 낮추고 `up -d`로 컨테이너를 다시 만들면 즉시 적용된다.
# (`restart`로는 반영되지 않는다.) 이미 오늘 한도를 쓴 팀의 카운트는 그대로 유지되므로,
# 한도를 낮추면 그날 남은 횟수가 즉시 줄어든다.
#DAILY_SUBMISSION_LIMIT=3

# 세션 쿠키 유효 시간(초). 생략하면 8시간.
# **지정하지 않으면 Starlette 기본값이 14일**이라, 공용 PC에서 로그인한 관리자 세션이
# 2주 동안 살아 있게 된다. 값을 늘릴 때는 그 점을 감안한다.
#SESSION_MAX_AGE_SECONDS=28800

# --- PostgreSQL ---
# docker-compose.yml의 db 서비스와 아래 DATABASE_URL이 함께 참조한다.
# 주의: 이 값들은 DB 볼륨(db_data)을 처음 만들 때만 적용된다. 이미 돌고 있는
# DB의 비밀번호를 바꾸려면 컨테이너 안에서 ALTER USER를 실행하거나
# 볼륨을 지우고 다시 만들어야 한다.
POSTGRES_USER=drleader
POSTGRES_PASSWORD=drleader
POSTGRES_DB=drleader

# 호스트에서 직접 실행하는 워커(worker/)와 alembic이 쓰는 접속 문자열.
# 컨테이너 안의 web 서비스는 docker-compose.yml에서 host를 db로 바꿔 주입한다.
DATABASE_URL=postgresql+psycopg2://drleader:drleader@localhost:5432/drleader

# --- 웹과 워커가 다른 기기일 때 (cloud-migration.md §4) ---
# WORKER_TOKEN이 있으면 워커가 HTTP로 모델을 받고 영상·metrics를 올린다. 비어 있으면
# 웹과 같은 디스크를 공유하는 방식으로 동작한다. 웹 서버와 워커 서버에 **같은 값**을 넣는다.
# 만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
#WORKER_TOKEN=
# 워커가 모델을 받아 오는 웹 서버 주소. 워커 서버에만 필요하다.
#WEB_BASE_URL=https://spg-deepracer.doublejeong.com
#
# 평가 서버(EC2)의 .env에는 DATABASE_URL · WEB_BASE_URL · WORKER_TOKEN 세 개만 둔다.
# 나머지는 웹 서버용이다 — 이유는 docs/worker-server-setup.md §8.2 ③.

# --- 평가 서버 자동 켜기·끄기 + 디스코드 알림 (worker-auto-start-stop-plan.md) ---
# **웹 서버(Lightsail) .env에만** 넣는다. 평가 서버(EC2)에는 넣지 않는다 — 평가 서버는 스스로
# poweroff해서 꺼지므로 AWS 키가 필요 없고, 알림도 웹 서버가 대신 보낸다.
# 값이 비어 있으면 autopilot 컨테이너는 아무것도 하지 않는다(기존 배포가 깨지지 않는다).
#
# 대상 평가 서버 인스턴스 ID. 비밀값은 아니다. 인스턴스를 새로 만들면 이 값만 바꾼다.
#AUTOPILOT_INSTANCE_ID=i-0123456789abcdef0
#AUTOPILOT_REGION=ap-northeast-2
#
# 켜기 전용 IAM 사용자(drleader-autopilot)의 액세스 키. **비밀값.** root 계정 키는 절대 쓰지 않는다.
# compose가 autopilot 서비스에만 넘긴다(web에는 넘기지 않는다). 발급 절차: docs/worker-server-setup.md
#AWS_ACCESS_KEY_ID=<IAM 콘솔에서 발급>
#AWS_SECRET_ACCESS_KEY=<IAM 콘솔에서 발급 — 한 번만 보인다>
#
# 운영 채널의 디스코드 웹훅. **비밀값** — 알면 누구나 그 채널에 글을 쓸 수 있다. 채팅·문서에 붙이지 않는다.
#DISCORD_WEBHOOK_URL=<디스코드 채널 설정 → 연동 → 웹후크에서 복사>
#
# 시간 값(분)은 명세서 확정값이 코드 기본값이다. 바꿀 때만 넣는다.
#AUTOPILOT_START_TIMEOUT_MINUTES=10
# (유일한 예외) 유휴 몇 분 뒤 끌지는 평가 서버가 판단하므로, 바꾸려면 **평가 서버 .env**에 넣는다.
#AUTOSTOP_IDLE_MINUTES=30
